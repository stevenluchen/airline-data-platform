# Pipeline PostgreSQL. Use localhost for commands run on the Mac; Docker
# Compose overrides POSTGRES_HOST to postgres inside Airflow containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airline_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# OpenSky OAuth2 client credentials.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Airflow metadata database and web UI secrets.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_API_JWT_SECRET=replace-with-a-long-random-value
AIRFLOW_SECRET_KEY=replace-with-a-long-random-value
